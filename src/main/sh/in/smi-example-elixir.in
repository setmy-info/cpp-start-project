#!/bin/sh

# Runs the compiled Elixir application: Smi.Example.main/1 with the arguments. The libraries of
# this project, the application and its dependencies, are ERL_LIBS, so the elixir on PATH finds
# them; the consolidated protocols are added in front.

BEAM_LIBS="@SCRIPTS_INSTALL_PREFIX@/lib/elixir/@PROJECT_NAME@"
ERL_LIBS="${BEAM_LIBS}${ERL_LIBS:+:${ERL_LIBS}}"
export ERL_LIBS

exec elixir -pa "${BEAM_LIBS}/@ELIXIR_APP@/consolidated" -e 'Smi.Example.main(System.argv())' -- "$@"
